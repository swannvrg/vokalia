# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# SMTP (Infomaniak — envoi des emails transactionnels)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=contact@votredomaine.fr
PASSWORD_MAIL_VOKALIA=votre_mot_de_passe_smtp
BOOKING_NOTIFY_EMAIL=adresse-de-notification@example.com

# Webhook Supabase — notification des demandes de rappel
CALLBACK_WEBHOOK_SECRET=your_webhook_secret
# Ancienne valeur, acceptée en plus de la nouvelle pendant un changement de secret.
# Laisser vide en temps normal ; la supprimer de Vercel une fois le changement terminé.
CALLBACK_WEBHOOK_SECRET_PREVIOUS=

# URL publique du site (sans slash final) pour les QR codes et fiches publiques
NEXT_PUBLIC_SITE_URL=https://vokalia.fr

# Cloudflare Turnstile (optionnel pour le formulaire de demande d'invitation)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
